.build/
.swiftpm/
*.xcodeproj
*.xcworkspace
DerivedData/
.DS_Store
.ruff_cache/
CLAUDE.md
.claude/

# Working notes kept on each developer's machine, outside the published tree:
# agent conventions, design plans and handoffs, and icon source artwork. Design
# files can carry the author's details in their metadata.
/AGENTS.md
/docs/*.md
*.ai

# Runtime coordination for the single headset control channel (never committed)
.control-session.lock
.control-session.log
__pycache__/
*.pyc

# Signing and notarization credentials. The build never reads these — it takes an
# identity *name* and a Keychain profile *name*, and the secrets stay in the
# Keychain — so a file matching one of these in the tree is an accident.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
